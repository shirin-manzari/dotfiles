# Shell history
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# Completion and command-line editing
autoload -Uz compinit
compinit
bindkey -e

# Prompt: user, current directory, prompt character
PROMPT='%n %~ %# '

# Keep machine-specific paths, aliases, and secrets outside the repository.
if [[ -f "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
